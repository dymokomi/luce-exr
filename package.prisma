#prisma 4.0
def package "luce-exr" {
    str owner = "dymokomi"
    str version = "0.1.0"
    str kind = "package"
    str language = "luce-base"
    str description = "An OpenEXR reader and writer for Luce/Base: scanline and tiled images, none/RLE/ZIP/PIZ/PXR24 compression, half and float channels."
    str readme = "README.md"

    def dependency "luce-raster" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-raster"
    }

    def dependency "luce-deflate" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-deflate"
    }

    def export "exr" {
        str module = "luce_exr.exr"
    }
}
