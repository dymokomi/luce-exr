#prisma 4.0
def package "luce-exr" {
    str owner = "dymokomi"
    str version = "0.5.0"
    str kind = "package"
    str language = "luce-base"
    str description = "An OpenEXR reader and writer for Luce/Base: scanline and tiled images, none/RLE/ZIP/PIZ/PXR24 compression, half and float channels, and Cryptomatte 1.2 layers."
    str readme = "README.md"
    str[] public = ["cryptomatte", "exr"]

    def dependency "luce-raster" {
        str owner = "dymokomi"
        str version = "^0.4.0"
        str path = "../luce-raster"
    }

    def dependency "luce-compress" {
        str owner = "dymokomi"
        str version = "^0.6.0"
        str path = "../luce-compress"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.5.0"
        str path = "../luce-std"
    }
}
