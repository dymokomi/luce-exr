from cryptomatte import Cryptomatte, layer_count, layer_name

pub func main(arguments: list[str]) -> int!:
    let count = layer_count(arguments[0])
    assert(count > 0)
    for i in 0..<count:
        let layer = Cryptomatte.open(arguments[0], layer_name(arguments[0], i))
        assert(layer.manifest_count() > 0)
        let selected = layer.manifest_name(0)
        let mask = layer.extract([selected])
        mask.save(arguments[1] + "/mask" + str(i) + ".exr")
        print(layer.name())
        print(selected)
    return 0
